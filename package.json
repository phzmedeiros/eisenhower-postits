{
	"name": "eisenhower-postits",
	"version": "1.1.0",
	"description": "Organize your priorities as sticky notes on an Eisenhower matrix.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"eisenhower",
		"priorities",
		"sticky-notes"
	],
	"author": "Pedro Henrique Medeiros dos Reis",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^20.11.30",
		"esbuild": "0.21.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.4.5",
		"typescript-eslint": "^8.72.1"
	}
}
